			AimTrackingInterval 0.05
			FireInput
			{
				Target !self
				Action runscriptcode
				Param "HellOnEarth.SendAnnotationOn(self, `VIP HEALTH CRITICAL`, 5, true)"
				Delay 0
				Repeats 15
				Cooldown 15
				IfHealthBelow 2501
			}
			FireInput
			{
				Target engie_hint_node_final
				Action ForceSpawn
				Delay 1
				Repeats 1
			}
			EventChangeAttributes
			{
				FINAL_NODE_REACHED
				{
					FireInput
					{
						Target node_final_reached 
						Action Trigger
						Delay 1
						Repeats 1
					}
					FireInput
					{
						Target !activator
						Action $Taunt
						Repeats 1
						Delay 0
					}
					FireInput
					{
						Target !activator
						Action runscriptcode
						Param "HellOnEarth.PlaySoundFromEntity(self,`vo/mvm/norm/engineer_mvm_gunslingertriplepunchfinal01.mp3`)"
						Repeats 1
						Delay 0
					}
					InterruptAction
					{
						Target "2289 -2440 250"

						StopCurrentInterruptAction 1

						Delay 1
						Repeats 1
						Duration 1

						WaitUntilDone 1
						OnDoneChangeAttributes "ENGY_DISSAPEAR"
							
						Distance 0
						AddToQueue 1
					}
				}
				ENGY_DISSAPEAR
				{
					FireInput
					{
						Target !activator
						Action runscriptcode
						Param "
							SetPropBool(self, `m_bUseBossHealthBar`, false)
							self.ForceChangeTeam(1, true)
							self.Destroy()
						"
					}
				}
			}
			CharacterAttributes
            {
                "move speed bonus"	0.5
                "damage force reduction" 0.025
                "airblast vulnerability multiplier" 0.025
				"health regen" 35
				"override footstep sound set" 4
				"mult stun resistance" 0
				"displace touched enemies" 3
				"dmg taken from fire reduced" 0.8
            }
		}
